+++ b/public/style.css
@@ -1,20 +1,94 @@
-/* BunTrade app styles — the "BunTrade Mobile" design: a single scrolling
-   page (header, account strip, markets list, trade card, portfolio card,
-   order history), light theme only, on top of the ACME design language
-   (acme.css). Color convention per the source design: positive/flat values
-   use the default text color, only negative values get --acme-color-danger
-   — there is no "success green" anywhere in this design.
-
-   Asset-class tabs and futures (long/short, margin) are not part of the
-   design, which only models plain buy/sell equities — they're kept here
-   as an extension so the real backend's futures/commodities instruments
-   stay reachable, styled with the same tokens and components. */
+/* BunTrade app styles — single scrolling page (header, account strip,
+   markets list, trade card, portfolio card, order history) on top of the
+   ACME component layer (acme.css), reskinned to match Binance's dark
+   trading-terminal look: near-black canvas, yellow brand accent, and the
+   crypto-exchange convention of green-up/red-down everywhere (price
+   changes, charts, sparklines, Buy vs Sell/Long vs Short).
 
+   This block overrides acme.css's semantic tokens rather than editing
+   that file, so the ACME component definitions (buttons, cards, tabs,
+   badges) stay reusable while every color/shape decision lives here.
+   Bare :root has the same specificity as acme.css's own :root block, so
+   source order (this file loads after acme.css) decides the winner —
+   index.html intentionally sets no data-theme attribute so neither of
+   acme.css's higher-specificity `:root[data-theme=...]` blocks can
+   out-rank this override. */
+:root {
+  color-scheme: dark;
+
+  --acme-color-canvas: #0b0e11;
+  --acme-color-surface: #1e2329;
+  --acme-color-surface-raised: #2b3139;
+  --acme-color-border: #2b3139;
+  --acme-color-border-strong: #474d57;
+  --acme-color-text: #eaecef;
+  --acme-color-text-muted: #b7bdc6;
+  --acme-color-text-subtle: #848e9c;
+
+  --acme-color-primary: #f0b90b;
+  --acme-color-primary-hover: #f8d33a;
+  --acme-color-primary-active: #d9a506;
+  --acme-color-on-primary: #202630;
+  --acme-color-link: #f0b90b;
+  --acme-color-focus: #f0b90b;
+
+  --acme-color-success: #0ecb81;
+  --acme-color-success-soft: color-mix(in oklab, #0ecb81 16%, #1e2329);
+  --acme-color-success-soft-text: #0ecb81;
+
+  --acme-color-warning: #f0b90b;
+  --acme-color-warning-soft: color-mix(in oklab, #f0b90b 16%, #1e2329);
+  --acme-color-warning-soft-text: #f0b90b;
+
+  --acme-color-danger: #f6465d;
+  --acme-color-danger-emphasis: #f6465d;
+  --acme-color-danger-soft: color-mix(in oklab, #f6465d 16%, #1e2329);
+  --acme-color-danger-soft-text: #f6465d;
+
+  --acme-color-info: #58bcff;
+  --acme-color-info-soft: color-mix(in oklab, #58bcff 16%, #1e2329);
+  --acme-color-info-soft-text: #58bcff;
+
+  --acme-color-data: #58bcff;
+  --acme-color-data-highlight: #f0b90b;
+
+  --acme-shadow-sm: 0 1px 2px rgb(0 0 0 / 0.4);
+  --acme-shadow-md: 0 4px 12px -2px rgb(0 0 0 / 0.5);
+  --acme-shadow-lg: 0 12px 32px -8px rgb(0 0 0 / 0.6);
+
+  /* Binance has no glassmorphism — flatten the "glass" materials into
+     solid panels. --acme-glass-edge stays a real (invisible) shadow
+     value, not `none`, since it's combined with --acme-shadow-* in a
+     single box-shadow list where `none` would make the whole rule invalid. */
+  --acme-material-glass: #1e2329;
+  --acme-material-glass-strong: #1e2329;
+  --acme-glass-blur: 0px;
+  --acme-glass-edge: 0 0 transparent;
+
+  /* Compact rounded rectangles instead of ACME's pill/capsule shapes. */
+  --acme-radius-full: 6px;
+  --acme-radius-lg: 10px;
+  --acme-radius-xl: 14px;
+
+  accent-color: var(--acme-color-primary);
+}
+
+.up { color: var(--acme-color-success); }
 .down { color: var(--acme-color-danger); }
 .num { font-variant-numeric: tabular-nums; }
 
 body { background: var(--acme-color-canvas); }
 
+/* The wordmark mark chip hardcodes ACME's raw red swatch rather than the
+   (now yellow) primary token — recolor it to match the brand accent. */
+.acme-wordmark__mark {
+  background: var(--acme-color-primary);
+  color: var(--acme-color-on-primary);
+}
+
+/* Binance's panels are flat with a hairline border, not shadow-only. */
+.acme-card { border: 1px solid var(--acme-color-border); }
+
 .app-shell {
   max-width: 480px;
   margin: 0 auto;
@@ -113,7 +187,7 @@ body { background: var(--acme-color-canvas); }
